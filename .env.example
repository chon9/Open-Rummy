# Open Rummy server configuration (example).
# Copy to /etc/open-rummy.env on a server (systemd EnvironmentFile) or export the variables
# yourself. Never commit a real .env file: .gitignore excludes .env and .env.*, and
# scripts/check-secrets.mjs blocks them. The server needs no secrets or API keys.
# Every variable is optional; an empty value means the default shown. Invalid integers make
# the server refuse to start with an error naming the value.

# TCP port the Node server listens on (HTTP + WebSocket on /ws, health check on /healthz).
# Default 3001.
PORT=3001

# Interface to bind. Default 0.0.0.0 (all interfaces). Use 127.0.0.1 behind nginx on a VM;
# 0.0.0.0 inside a container.
HOST=127.0.0.1

# Directory with the built client (packages/client/dist). Empty = packages/client/dist next to
# the server bundle. Behind nginx the static files are served by nginx, so this only matters
# without a proxy.
WEB_ROOT=

# Maximum number of concurrent rooms before new room creation is refused. Default 500.
MAX_ROOMS=500

# Comma-separated list of allowed WebSocket Origins, e.g. https://rummy.example.com
# Empty (default) = any Origin is accepted. Set it in production.
ALLOWED_ORIGINS=

# Set to production on servers (Node/library convention). The game server itself currently
# behaves the same either way.
NODE_ENV=production

# Number of reverse-proxy hops whose X-Forwarded-For entries are trusted for the client address
# used by the per-IP limits. Default 0 = ignore X-Forwarded-For and use the socket address
# (correct when clients connect directly). 1 = one proxy in front (nginx, a load balancer, the
# Lightsail container service) that sets/appends the real client address. Accepts 0-10,
# true/false. Never enable it when the port is reachable directly: clients could spoof addresses.
# Behind a CDN in front of nginx, configure nginx's realip module (see deploy/nginx) first.
TRUST_PROXY=1

# Total concurrent WebSocket connections. Default 4000.
MAX_CONNECTIONS=4000

# Concurrent WebSocket connections from one client IP. Default 20.
MAX_CONNS_PER_IP=20

# Live rooms one client IP may have created at the same time. Default 5.
MAX_ROOMS_PER_IP=5
